# Copy this file to .env and fill in what you need.
#
# ANTHROPIC_API_KEY is only read when you ask for the "haiku" model. The two
# Ollama models never touch it, so you can run this exercise for free by
# leaving it as the placeholder.
ANTHROPIC_API_KEY=Your API KEY

# Where the local Ollama daemon listens. Pydantic AI needs this set before it
# will resolve any "ollama:" model string; there is no default. The /v1 suffix
# matters: it is Ollama's OpenAI-compatible endpoint.
OLLAMA_BASE_URL=http://localhost:11434/v1
